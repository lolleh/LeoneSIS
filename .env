# Copy this file to .env and adjust the values before starting the stack.

# Port exposed on the host.
APP_PORT=8081

# PostgreSQL database credentials. Change these for anything beyond a local demo.
POSTGRES_DB=schoolms
POSTGRES_USER=schoolms
POSTGRES_PASSWORD=schoolms

# Seed the demo school, accounts and sample content on first start.
APP_SEED_DEMO_DATA=true

# JVM options for the application container.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport
